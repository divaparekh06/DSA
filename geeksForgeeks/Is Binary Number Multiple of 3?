class Solution {
  public:
    bool isMultipleOf3(string& s) {
        int remainder=0;
    int current_bit=0;
    for(int i=0; i<s.size();i++){
        current_bit = s[i]-'0';
        remainder=(remainder*2+current_bit)%3;
        
    }
    if(remainder%3==0){
            return true;
        }
    else{
        return false;
    }
    }
};
